source .github/scripts/run-step.sh
run_step npm run validate:contract-drift
run_step npm run validate:db-types-drift
run_step npm run validate:lane-topology
run_step npm run validate:coverage-scoping
run_step npm run validate:lakehouse-types-drift
run_step npm run validate:lakehouse-readers
run_step npm run validate:store-type-parity
run_step npm run validate:featured-validators-drift
run_step npm run validate:rpc-usage-slots-drift
run_step npm run validate:retired-storage
run_step npm run validate:archive-policy
run_step npm run validate:schema-enums
run_step npm run validate:openapi-examples
run_step npm run validate:generated-client
run_step npm run validate:graphql-types-drift
run_step npm run validate:worker-types-parity
run_step npm run validate:graphql-route-parity
run_step npm run validate:graphql-hand-written-checks
run_step npm run validate:graphql-component-parity
run_step npm run validate:graphql-query-arguments
run_step npm run validate:published-names
run_step npm run validate:graphql-tier-parity
run_step npm run validate:committed-seed
# Both of these were reachable only from the LOCAL gate, so a
# contract-only PR -- the exact PR that invalidates them -- got no CI
# coverage at all (#10251). They live in this step rather than the
# `ui` job because that job is gated on a path filter that matches
# neither schemas-src/ nor public/metagraph/openapi.json.
run_step npm run validate:ui-docs-drift
# #10300: published routes the UI renders nowhere. A RATCHET -- the
# count may only fall, so a new route either gets rendered or fails
# here rather than drifting up one PR at a time, which is how the
# gap went 30 -> 35 with nothing watching.
run_step npm run validate:ui-route-coverage
run_step npm run validate:untyped-db-reads
run_step npm run validate:readme-catalog
report_steps
