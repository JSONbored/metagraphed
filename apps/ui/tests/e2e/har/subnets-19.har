rydavid03023\"},\"source_urls\":[\"https://blockmachine.io/\",\"https://api.blockmachine.io/openapi.json\"],\"stale\":false,\"subnet_name\":\"blockmachine\",\"subnet_slug\":\"sn-19\",\"url\":\"https://api.blockmachine.io/epochs\"},{\"auth_required\":false,\"authority\":\"community\",\"curation_level\":\"candidate-discovered\",\"id\":\"sn-19-blockmachine-epochs-epoch-id\",\"key\":\"srf-615b3fa10270c815\",\"kind\":\"subnet-api\",\"last_verified_at\":null,\"name\":\"BlockMachine epochs epoch id\",\"netuid\":19,\"notes\":\"Get Epoch operation on the BlockMachine API (GET /epochs/{epoch_id}), declared in the subnet's own OpenAPI spec at https://api.blockmachine.io/openapi.json. Path-parameterized, so there is no single fixed callable URL; the template is registered per the registry's catalog-everything policy (Phase 2).\",\"probe\":{\"enabled\":false,\"expect\":\"json\",\"method\":\"GET\",\"timeout_ms\":10000},\"provider\":\"blockmachine\",\"public_safe\":true,\"review\":{\"state\":\"community-submitted\",\"submitted_by\":\"joaovictor91123\"},\"source_urls\":[\"https://api.blockmachine.io/openapi.json\"],\"stale\":null,\"subnet_name\":\"blockmachine\",\"subnet_slug\":\"sn-19\",\"url\":\"https://api.blockmachine.io/epochs/%7Bepoch_id%7D\"},{\"auth_required\":false,\"authority\":\"community\",\"curation_level\":\"candidate-discovered\",\"id\":\"sn-19-blockmachine-epochs-epoch-id-finalize\",\"key\":\"srf-2a643e3c5f400380\",\"kind\":\"subnet-api\",\"last_verified_at\":null,\"name\":\"BlockMachine epochs epoch id finalize\",\"netuid\":19,\"notes\":\"Finalize Epoch operation on the BlockMachine API (POST /epochs/{epoch_id}/finalize), declared in the subnet's own OpenAPI spec at https://api.blockmachine.io/openapi.json. Path-parameterized, so there is no single fixed callable URL; the template is registered per the registry's catalog-everything policy (Phase 2).\",\"probe\":{\"enabled\":false,\"expect\":\"json\",\"method\":\"GET\",\"timeout_ms\":10000},\"provider\":\"blockmachi