ps://github.com/macrocosm-os/apex/blob/main/shared/common/src/common/settings.py\"],\"stale\":false,\"subnet_name\":\"Apex\",\"subnet_slug\":\"sn-1\",\"url\":\"https://apex.api.macrocosmos.ai/healthcheck\"},{\"auth_required\":false,\"authority\":\"community\",\"curation_level\":\"machine-verified\",\"id\":\"sn-1-apex-healthcheck-ready\",\"key\":\"srf-fcd390d4676aeddd\",\"kind\":\"subnet-api\",\"last_verified_at\":\"2026-08-22T04:30:39.879Z\",\"name\":\"Apex orchestrator readiness check\",\"netuid\":1,\"notes\":\"Public no-auth GET returning readiness status (observed: {\\\"status\\\":\\\"ready\\\"}), distinct from the already-tracked liveness /healthcheck. Documented in the subnet's own OpenAPI schema (path /healthcheck/ready); same host as the existing healthcheck surface. Live-verified 2026-07-22: HTTP 200 JSON {\\\"status\\\":\\\"ready\\\"}.\",\"probe\":{\"enabled\":true,\"expect\":\"json\",\"method\":\"GET\",\"timeout_ms\":10000},\"provider\":\"macrocosmos\",\"public_safe\":true,\"review\":{\"state\":\"community-submitted\",\"submitted_by\":\"jsonbored\"},\"source_urls\":[\"https://apex.api.macrocosmos.ai/openapi.json\"],\"stale\":false,\"subnet_name\":\"Apex\",\"subnet_slug\":\"sn-1\",\"url\":\"https://apex.api.macrocosmos.ai/healthcheck/ready\"},{\"auth_required\":false,\"authority\":\"community\",\"curation_level\":\"machine-verified\",\"id\":\"sn-1-apex-metrics\",\"key\":\"srf-efc1590639bd9f16\",\"kind\":\"subnet-api\",\"last_verified_at\":\"2026-08-22T04:30:39.879Z\",\"name\":\"Apex orchestrator Prometheus metrics\",\"netuid\":1,\"notes\":\"Public no-auth GET returning Prometheus text-exposition-format process/runtime metrics (python_gc_objects_collected_total and similar). Documented in the subnet's own OpenAPI schema (path /metrics); plain-text response, not JSON, so tracked with expect: any. Live-verified 2026-07-22: HTTP 200 Prometheus text exposition.\",\"probe\":{\"enabled\":true,\"expect\":\"any\",\"method\":\"GET\",\"timeout_ms\":10000},\"provider\":\"macrocosmos\",\"public_safe\":true,\"review\":{\"state\":\"community-submitted\",\"submitted_by\":\"jsonbored\"},\"source_urls\":[\"https://apex.api.macrocosmos.ai/openapi.json\"],\"stale\":false,\"subnet_name\":\"Apex\",\"subnet_slug\":\"sn-1\",\"url\":\"https://apex.api.macrocosmos.ai/metrics\"},{\"auth_required\":false,\"authority\":\"community\",\"curation_level\":\"candidate-discovered\",\"id\":\"sn-1-apex-miner-competition\",\"key\":\"srf-4da409e63b73e2c1\",\"kind\":\"subnet-api\",\"last_verified_at\":null,\"name\":\"Apex miner competition\",\"netuid\":1,\"notes\":\"Get Competition operation on the Apex orchestrator API (GET /miner/competition), declared in the subnet's own OpenAPI spec at https://apex.api.macrocosmos.ai/openapi.json. Live-checked 2026-07-21: the bare URL returns HTTP 400 rejecting a missing or invalid on-chain address parameter, so it is parameter-gated rather than credential-gated; the probe is disabled and no auth requirement is asserted.\",\"probe\":{\"enabled\":false,\"expect\":\"json\",\"method\":\"GET\",\"timeout_ms\":10000},\"provider\":\"macrocosmos\",\"public_safe\":true,\"review\":{\"state\":\"community-submitted\",\"submitted_by\":\"joaovictor91123\"},\"source_urls\":[\"https://apex.api.macrocosmos.ai/openapi.json\"],\"stale\":null,\"subnet_name\":\"Apex\",\"subnet_slug\":\"sn-1\",\"url\":\"https://apex.api.macrocosmos.ai/miner/competition\"},{\"auth_required\":false,\"authority\":\"community\",\"curation_level\":\"candidate-discovered\",\"id\":\"sn-1-apex-miner-competitions-competition-id-previous-round-input-files\",\"key\":\"srf-6a0afc0c74a5d56e\",\"kind\":\"subnet-api\",\"last_verified_at\":null,\"name\":\"Apex miner competitions competition id previous round input files\",\"netuid\":1,\"notes\":\"Get Previous Round Input Files operation on the Apex orchestrator API (GET /miner/competitions/{competition_id}/previous-round-input-files), declared in the subnet's own OpenAPI spec at https://apex.api.macrocosmos.ai/openapi.json.