d\",\"submitted_by\":\"jsonbored\"},\"source_urls\":[\"https://apex.api.macrocosmos.ai/openapi.json\"],\"stale\":false,\"subnet_name\":\"Apex\",\"subnet_slug\":\"sn-1\",\"url\":\"https://apex.api.macrocosmos.ai/metrics\"},{\"auth_required\":false,\"authority\":\"community\",\"curation_level\":\"candidate-discovered\",\"id\":\"sn-1-apex-miner-competition\",\"key\":\"srf-4da409e63b73e2c1\",\"kind\":\"subnet-api\",\"last_verified_at\":null,\"name\":\"Apex miner competition\",\"netuid\":1,\"notes\":\"Get Competition operation on the Apex orchestrator API (GET /miner/competition), declared in the subnet's own OpenAPI spec at https://apex.api.macrocosmos.ai/openapi.json. Live-checked 2026-07-21: the bare URL returns HTTP 400 rejecting a missing or invalid on-chain address parameter, so it is parameter-gated rather than credential-gated; the probe is disabled and no auth requirement is asserted.\",\"probe\":{\"enabled\":false,\"expect\":\"json\",\"method\":\"GET\",\"timeout_ms\":10000},\"provider\":\"macrocosmos\",\"public_safe\":true,\"review\":{\"state\":\"community-submitted\",\"submitted_by\":\"joaovictor91123\"},\"source_urls\":[\"https://apex.api.macrocosmos.ai/openapi.json\"],\"stale\":null,\"subnet_name\":\"Apex\",\"subnet_slug\":\"sn-1\",\"url\":\"https://apex.api.macrocosmos.ai/miner/competition\"},{\"auth_required\":false,\"authority\":\"community\",\"curation_level\":\"candidate-discovered\",\"id\":\"sn-1-apex-miner-competitions-competition-id-previous-round-input-files\",\"key\":\"srf-6a0afc0c74a5d56e\",\"kind\":\"subnet-api\",\"last_verified_at\":null,\"name\":\"Apex miner competitions competition id previous round input files\",\"netuid\":1,\"notes\":\"Get Previous Round Input Files operation on the Apex orchestrator API (GET /miner/competitions/{competition_id}/previous-round-input-files), declared in the subnet's own OpenAPI spec at https://apex.api.macrocosmos.ai/openapi.json. Path-parameterized, so there is no single fixed callable URL; the template is r