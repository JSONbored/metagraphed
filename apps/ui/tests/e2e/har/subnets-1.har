ta, API or model-inference costs, which on several subnets exceed the hardware.\",\"The registration burn is the price of ONE entry at the moment it was read; it moves with demand and a deregistered UID does not get it back.\"],\"field_sources\":{\"entry_cost.registration_cost_tao\":{\"kind\":\"measured\",\"storage\":\"SubtensorModule.Burn\"},\"entry_cost.validator_permit_floor_tao\":{\"kind\":\"measured\",\"storage\":\"SubtensorModule.Alpha\"},\"declared_compute.miner\":{\"kind\":\"measured\",\"storage\":\"compute_declarations\"},\"declared_compute.validator\":{\"kind\":\"measured\",\"storage\":\"compute_declarations\"},\"declared_compute.unscoped\":{\"kind\":\"measured\",\"storage\":\"compute_declarations\"},\"declared_compute.miner.gpu.requirement\":{\"kind\":\"reconstructed\",\"storage\":null},\"earnings.zero_emission_pct\":{\"kind\":\"measured\",\"storage\":\"neuron_daily\"}}},\"meta\":{\"contract_version\":\"2026-07-03.2\"}}"},"headersSize":0,"bodySize":968,"redirectURL":"","_transferSize":968},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":1584.368,"receive":0.415},"_resourceType":"fetch","serverIPAddress":"104.18.18.137","_serverPort":443,"_securityDetails":{"protocol":"TLS 1.3","subjectName":"metagraph.sh","issuer":"WE1","validFrom":1786224316,"validTo":1794003913}},{"pageref":"page@2793952ce7d9c2849e67b21c9d647736","startedDateTime":"2026-08-23T02:09:37.788Z","time":6194.969000000001,"request":{"method":"GET","url":"https://api.metagraph.sh/api/v1/subnets/1/registrations?window=30d","httpVersion":"HTTP/2.0","cookies":[],"headers":[{"name":":authority","value":"api.metagraph.sh"},{"name":":method","value":"GET"},{"name":":path","value":"/api/v1/subnets/1/registrations?window=30d"},{"name":":scheme","value":"https"},{"name":"accept","value":"application/json"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"origin","value":"http://localhost:8080"},{"name":"priority","value":"u=1, i"},{"name":"referer","value":"http