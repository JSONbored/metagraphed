mit rule still reproduces the permits the chain actually granted. Published so a caller can see when the model has drifted rather than trusting a floor it no longer supports.\",\"fields\":[{\"name\":\"matched\",\"description\":null,\"args\":[],\"type\":{\"kind\":\"NON_NULL\",\"name\":null,\"ofType\":{\"name\":\"Int\",\"kind\":\"SCALAR\",\"ofType\":null}},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"over_predicted\",\"description\":null,\"args\":[],\"type\":{\"kind\":\"NON_NULL\",\"name\":null,\"ofType\":{\"name\":\"Int\",\"kind\":\"SCALAR\",\"ofType\":null}},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"under_predicted\",\"description\":null,\"args\":[],\"type\":{\"kind\":\"NON_NULL\",\"name\":null,\"ofType\":{\"name\":\"Int\",\"kind\":\"SCALAR\",\"ofType\":null}},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"observed_permits\",\"description\":null,\"args\":[],\"type\":{\"kind\":\"NON_NULL\",\"name\":null,\"ofType\":{\"name\":\"Int\",\"kind\":\"SCALAR\",\"ofType\":null}},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"agreement\",\"description\":null,\"args\":[],\"type\":{\"kind\":\"SCALAR\",\"name\":\"Float\",\"ofType\":null},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"publishable\",\"description\":null,\"args\":[],\"type\":{\"kind\":\"NON_NULL\",\"name\":null,\"ofType\":{\"name\":\"Boolean\",\"kind\":\"SCALAR\",\"ofType\":null}},\"isDeprecated\":false,\"deprecationReason\":null}],\"inputFields\":null,\"interfaces\":[],\"enumValues\":null,\"possibleTypes\":null},{\"kind\":\"OBJECT\",\"name\":\"ValidatorEconomicsExclusion\",\"description\":\"One subnet the ranking dropped, and why, so that a caller can tell an omitted subnet from an absent one without re-deriving the ranking.\",\"fields\":[{\"name\":\"netuid\",\"description\":null,\"args\":[],\"type\":{\"kind\":\"NON_NULL\",\"name\":null,\"ofType\":{\"name\":\"Int\",\"kind\":\"SCALAR\",\"ofType\":null}},\"isDeprecated\":false,\"dep