ields\":null,\"inputFields\":null,\"interfaces\":null,\"enumValues\":[{\"name\":\"finney\",\"description\":null,\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"test\",\"description\":null,\"isDeprecated\":false,\"deprecationReason\":null}],\"possibleTypes\":null},{\"kind\":\"ENUM\",\"name\":\"ChainFirehoseTable\",\"description\":\"Which source table a live chain event came from. The same four topics the SSE firehose and the ingest validator accept.\",\"fields\":null,\"inputFields\":null,\"interfaces\":null,\"enumValues\":[{\"name\":\"blocks\",\"description\":null,\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"extrinsics\",\"description\":null,\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"chain_events\",\"description\":null,\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"account_events\",\"description\":null,\"isDeprecated\":false,\"deprecationReason\":null}],\"possibleTypes\":null},{\"kind\":\"SCALAR\",\"name\":\"JSON\",\"description\":\"Arbitrary JSON. Used where the shape is keyed by data (a record) or is a heterogeneous union, neither of which GraphQL's type system can express.\",\"fields\":null,\"inputFields\":null,\"interfaces\":null,\"enumValues\":null,\"possibleTypes\":null},{\"kind\":\"OBJECT\",\"name\":\"Query\",\"description\":null,\"fields\":[{\"name\":\"subnets\",\"description\":\"Paginated active-subnet index. Reads the same static /metagraph/subnets.json artifact as the list_subnets MCP tool and supports its full query surface: network scoping, categorical inclusion + negation filters, min_/max_ range bounds, and sort/order. Mirrors GET /api/v1/subnets.\",\"args\":[{\"name\":\"netuid\",\"description\":null,\"type\":{\"kind\":\"SCALAR\",\"name\":\"Int\",\"ofType\":null},\"defaultValue\":null},{\"name\":\"coverage_level\",\"description\":null,\"type\":{\"kind\":\"SCALAR\",\"name\":\"String\",\"ofType\":null},\"defaultValue\":null},{\"name\":\"curation_level\",\"description\":null,\"type\":{\"