recated\":false,\"deprecationReason\":null},{\"name\":\"segments\",\"description\":\"One entry per contributing store, oldest first. Two non-adjacent entries mean the window has a hole between them that no store covers.\",\"args\":[],\"type\":{\"kind\":\"NON_NULL\",\"name\":null,\"ofType\":{\"name\":null,\"kind\":\"LIST\",\"ofType\":{\"name\":null,\"kind\":\"NON_NULL\",\"ofType\":{\"name\":\"RpcUsageCoverageSegment\",\"kind\":\"OBJECT\",\"ofType\":null}}}},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"latency_percentiles\",\"description\":\"The sub-range summary.latency_ms p50/p95 describe, or null when nothing measured them. Counts are additive across disjoint ranges; percentiles are not, so they stay scoped to the one store that has a percentile function.\",\"args\":[],\"type\":{\"kind\":\"OBJECT\",\"name\":\"RpcUsageCoverageRange\",\"ofType\":null},\"isDeprecated\":false,\"deprecationReason\":null}],\"inputFields\":null,\"interfaces\":[],\"enumValues\":null,\"possibleTypes\":null},{\"kind\":\"OBJECT\",\"name\":\"RpcUsageCoverageSegment\",\"description\":\"One store's contribution to an rpc_usage answer.\",\"fields\":[{\"name\":\"source\",\"description\":\"Which store measured it: analytics-engine (live capture) or lakehouse (frozen history).\",\"args\":[],\"type\":{\"kind\":\"NON_NULL\",\"name\":null,\"ofType\":{\"name\":\"String\",\"kind\":\"SCALAR\",\"ofType\":null}},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"start\",\"description\":\"Epoch ms of this store's oldest measured event in the window.\",\"args\":[],\"type\":{\"kind\":\"SCALAR\",\"name\":\"Float\",\"ofType\":null},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"end\",\"description\":\"Epoch ms of this store's newest measured event in the window.\",\"args\":[],\"type\":{\"kind\":\"SCALAR\",\"name\":\"Float\",\"ofType\":null},\"isDeprecated\":false,\"deprecationReason\":null}],\"inputFields\":null,\"interfaces\":[],\"enumValues\":null,\"possibleTypes\"