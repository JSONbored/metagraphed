ype\":{\"kind\":\"SCALAR\",\"name\":\"Float\",\"ofType\":null},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"emission_gate_open\",\"description\":\"Reported, never scored. Gate-closed subnets still emit alpha at a comparable rate and are less contested, so per unit of stake they pay MORE -- the gate is an exit-liquidity question, not an eligibility one.\",\"args\":[],\"type\":{\"kind\":\"SCALAR\",\"name\":\"Boolean\",\"ofType\":null},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"tao_inflow_per_day\",\"description\":null,\"args\":[],\"type\":{\"kind\":\"SCALAR\",\"name\":\"Float\",\"ofType\":null},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"registration_cost_tao\",\"description\":null,\"args\":[],\"type\":{\"kind\":\"SCALAR\",\"name\":\"Float\",\"ofType\":null},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"stake_threshold_units\",\"description\":\"Echoed so a caller never has to guess what the floor was computed against. Both are sudo-settable, so a cached copy would silently rot.\",\"args\":[],\"type\":{\"kind\":\"SCALAR\",\"name\":\"Float\",\"ofType\":null},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"tao_weight\",\"description\":null,\"args\":[],\"type\":{\"kind\":\"SCALAR\",\"name\":\"Float\",\"ofType\":null},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"model_agreement\",\"description\":null,\"args\":[],\"type\":{\"kind\":\"OBJECT\",\"name\":\"ValidatorPermitModelAgreement\",\"ofType\":null},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"degraded_reason\",\"description\":\"Names the missing input whenever a field above was withheld, so a caller can tell 'unknown' from 'zero'.\",\"args\":[],\"type\":{\"kind\":\"SCALAR\",\"name\":\"String\",\"ofType\":null},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"field_sources\",\"description\":\"Per-field { kind, storage } provenance map: every value is labelled measured (with the pallet-