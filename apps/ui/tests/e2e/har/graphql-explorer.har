OBJECT\",\"name\":\"ChainPerformance\",\"description\":\"Network-wide reward-distribution & score-spread card (#5688) -- the network analog of SubnetPerformance, spanning every subnet's neurons in one snapshot. Metric blocks are null on a cold/empty store. Mirrors GET /api/v1/chain/performance.\",\"fields\":[{\"name\":\"schema_version\",\"description\":null,\"args\":[],\"type\":{\"kind\":\"NON_NULL\",\"name\":null,\"ofType\":{\"name\":\"Int\",\"kind\":\"SCALAR\",\"ofType\":null}},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"subnet_count\",\"description\":\"Distinct subnets the snapshot spans.\",\"args\":[],\"type\":{\"kind\":\"NON_NULL\",\"name\":null,\"ofType\":{\"name\":\"Int\",\"kind\":\"SCALAR\",\"ofType\":null}},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"neuron_count\",\"description\":null,\"args\":[],\"type\":{\"kind\":\"NON_NULL\",\"name\":null,\"ofType\":{\"name\":\"Int\",\"kind\":\"SCALAR\",\"ofType\":null}},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"validator_count\",\"description\":null,\"args\":[],\"type\":{\"kind\":\"SCALAR\",\"name\":\"Int\",\"ofType\":null},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"active_count\",\"description\":null,\"args\":[],\"type\":{\"kind\":\"SCALAR\",\"name\":\"Int\",\"ofType\":null},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"captured_at\",\"description\":null,\"args\":[],\"type\":{\"kind\":\"SCALAR\",\"name\":\"String\",\"ofType\":null},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"incentive\",\"description\":\"Incentive concentration across all neurons network-wide with positive incentive.\",\"args\":[],\"type\":{\"kind\":\"OBJECT\",\"name\":\"ConcentrationMetrics\",\"ofType\":null},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"dividends\",\"description\":\"Dividends concentration across permitted validators network-wide only.\",\"args\":[],\"type\":{\"kind\":\"OBJECT\",\"name\":\"ConcentrationMetrics\",\"ofType\":null},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"trust\",\"description\":\"Trust score spread across all neurons network-wide.\",\"args\":[],\"type\":{\"kind\":\"OBJECT\",\"name\":\"ScoreDistribution\",\"ofType\":null},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"consensus\",\"description\":\"Consensus score spread across all neurons network-wide.\",\"args\":[],\"type\":{\"kind\":\"OBJECT\",\"name\":\"ScoreDistribution\",\"ofType\":null},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"validator_trust\",\"description\":\"Validator-trust score spread across permitted validators network-wide only.\",\"args\":[],\"type\":{\"kind\":\"OBJECT\",\"name\":\"ScoreDistribution\",\"ofType\":null},\"isDeprecated\":false,\"deprecationReason\":null}],\"inputFields\":null,\"interfaces\":[],\"enumValues\":null,\"possibleTypes\":null},{\"kind\":\"OBJECT\",\"name\":\"ChainYield\",\"description\":\"Network-wide emission-yield (return rate) card across every subnet's neurons. Aggregates are null on a cold store (schema-stable, never a GraphQL error). Mirrors GET /api/v1/chain/yield.\",\"fields\":[{\"name\":\"schema_version\",\"description\":null,\"args\":[],\"type\":{\"kind\":\"NON_NULL\",\"name\":null,\"ofType\":{\"name\":\"Int\",\"kind\":\"SCALAR\",\"ofType\":null}},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"subnet_count\",\"description\":\"How many subnets the aggregate spans. Root (netuid 0) is NOT one of them and is excluded from every figure below (#9040): root stake is TAO, not a subnet alpha token.\",\"args\":[],\"type\":{\"kind\":\"NON_NULL\",\"name\":null,\"ofType\":{\"name\":\"Int\",\"kind\":\"SCALAR\",\"ofType\":null}},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"neuron_count\",\"description\":null,\"args\":[],\"type\":{\"kind\":\"NON_NULL\",\"name\":null,\"ofType\":{\"name\":\"Int\",\"kind\":\"SCALAR\",\"ofType\":null}},\"isDeprecated\":false,\"deprecationReason\"