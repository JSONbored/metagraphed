e,\"deprecationReason\":null},{\"name\":\"points\",\"description\":null,\"args\":[],\"type\":{\"kind\":\"NON_NULL\",\"name\":null,\"ofType\":{\"name\":null,\"kind\":\"LIST\",\"ofType\":{\"name\":null,\"kind\":\"NON_NULL\",\"ofType\":{\"name\":\"SubnetBurnHistoryPoint\",\"kind\":\"OBJECT\",\"ofType\":null}}}},\"isDeprecated\":false,\"deprecationReason\":null}],\"inputFields\":null,\"interfaces\":[],\"enumValues\":null,\"possibleTypes\":null},{\"kind\":\"OBJECT\",\"name\":\"SubnetBurnHistoryPoint\",\"description\":null,\"fields\":[{\"name\":\"observed_at\",\"description\":null,\"args\":[],\"type\":{\"kind\":\"NON_NULL\",\"name\":null,\"ofType\":{\"name\":\"String\",\"kind\":\"SCALAR\",\"ofType\":null}},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"burn_tao\",\"description\":null,\"args\":[],\"type\":{\"kind\":\"NON_NULL\",\"name\":null,\"ofType\":{\"name\":\"Float\",\"kind\":\"SCALAR\",\"ofType\":null}},\"isDeprecated\":false,\"deprecationReason\":null}],\"inputFields\":null,\"interfaces\":[],\"enumValues\":null,\"possibleTypes\":null},{\"kind\":\"OBJECT\",\"name\":\"SubnetTurnover\",\"description\":\"One subnet's validator/neuron-set turnover between a window's boundary snapshots. The churn metrics are zeroed and the retentions/stability null on a single-snapshot or cold store (schema-stable). Mirrors GET /api/v1/subnets/{netuid}/turnover's default scorecard.\",\"fields\":[{\"name\":\"schema_version\",\"description\":null,\"args\":[],\"type\":{\"kind\":\"NON_NULL\",\"name\":null,\"ofType\":{\"name\":\"Int\",\"kind\":\"SCALAR\",\"ofType\":null}},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"netuid\",\"description\":null,\"args\":[],\"type\":{\"kind\":\"NON_NULL\",\"name\":null,\"ofType\":{\"name\":\"Int\",\"kind\":\"SCALAR\",\"ofType\":null}},\"isDeprecated\":false,\"deprecationReason\":null},{\"name\":\"window\",\"description\":null,\"args\":[],\"type\":{\"kind\":\"SCALAR\",\"name\":\"String\",\"ofType\":null},\"isDeprecated\":false,