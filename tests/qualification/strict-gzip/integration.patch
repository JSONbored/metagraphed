+import { gzipSync } from "node:zlib";
+
+export const RESOURCE_FIRST_DIFFERENCES = [
+  "bad-crc",
+  "bad-isize",
+  "truncated",
+  "trailing-zero",
+] as const;
+export type ResourceFirstDifference =
+  (typeof RESOURCE_FIRST_DIFFERENCES)[number];
+
+/** Driver/test-host fixture generation only. Never import into Worker code.
+ * The JSON is complete before compressible trailing whitespace crosses the
+ * decoded ceiling. The compressed bytes fit the unchanged queue wire ceiling.
+ * The maximum expansion allocation belongs to the test host, not the Worker.
+ */
+export function resourceFirstVariants(
+  json: string,
+  decodedCeiling: number,
+): Map<ResourceFirstDifference, Uint8Array> {
+  const bytes = Buffer.byteLength(json);
+  if (bytes > decodedCeiling)
+    throw new Error("Fixture JSON already exceeds ceiling");
+  const valid = gzipSync(json + " ".repeat(decodedCeiling + 65_537 - bytes), {
+    level: 9,
+  });
+  if (valid.length + 1 > 128 * 1024)
+    throw new Error("Fixture exceeds unchanged transport ceiling");
+  const crc = Uint8Array.from(valid);
+  crc[crc.length - 8]! ^= 1;
+  const isize = Uint8Array.from(valid);
+  isize[isize.length - 4]! ^= 1;
+  const zero = new Uint8Array(valid.length + 1);
+  zero.set(valid);
+  return new Map([
+    ["bad-crc", crc],
+    ["bad-isize", isize],
+    ["truncated", Uint8Array.from(valid.subarray(0, -1))],
+    ["trailing-zero", zero],
+  ]);
+}
