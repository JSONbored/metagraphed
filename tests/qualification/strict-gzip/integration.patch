+import assert from "node:assert/strict";
+import { gzipSync } from "node:zlib";
+import { afterEach, describe, test, vi } from "vitest";
+import {
+  decompressSyncBatchMessage,
+  readSyncBatchJson,
+  SyncBatchExpansionError,
+} from "../src/sync-batch-compress.ts";
+import { SYNC_BATCH_MAX_DECODED_BYTES } from "../src/sync-batch-limits.ts";
+import * as strict from "../src/strict-gzip-reader.ts";
+import { resourceFirstVariants } from "./helpers/sync-resource-first-fixtures.ts";
+
+afterEach(() => vi.restoreAllMocks());
+
+describe("proposed resource-first decoder integration", () => {
+  test("preserves valid JSON and offset-view ownership", async () => {
+    const value = { lane: "fixture", text: "€ 🫧", nested: [1, null, true] };
+    const wire = Uint8Array.from(gzipSync(JSON.stringify(value)));
+    const backing = new Uint8Array(wire.length + 12).fill(0x55);
+    backing.set(wire, 7);
+    const view = backing.subarray(7, 7 + wire.length);
+    for (const body of [wire, wire.slice().buffer, view]) {
+      assert.deepEqual(await decompressSyncBatchMessage(body), value);
+    }
+    assert.equal(backing[0], 0x55);
+    assert.equal(backing.at(-1), 0x55);
+    assert.deepEqual(view, wire);
+  });
+
+  test("keeps replacement UTF-8 decoding and malformed JSON behavior", async () => {
+    const invalidUtf8 = new Uint8Array([0x22, 0xc3, 0x28, 0x22]);
+    assert.equal(
+      await decompressSyncBatchMessage(gzipSync(invalidUtf8)),
+      "\ufffd(",
+    );
+    assert.equal(await decompressSyncBatchMessage(gzipSync("{")), null);
+  });
+
+  test("still rejects malformed framing below the resource ceiling", async () => {
+    const valid = Uint8Array.from(gzipSync('{"ok":true}'));
+    const crc = valid.slice();
+    crc[crc.length - 8]! ^= 1;
+    const size = valid.slice();
+    size[size.length - 4]! ^= 1;
+    const trailing = new Uint8Array(valid.length + 1);
+    trailing.set(valid);
+    for (const wire of [crc, size, valid.subarray(0, -1), trailing]) {
+      assert.equal(await decompressSyncBatchMessage(wire), null);
+    }
+  });
+
+  test("cancels before exposing over-budget refusal and never demands the tail", async () => {
+    const originalRead = strict.readStrictGzip;
+    const observations: {
+      cancelled: boolean;
+      reads: number;
+      bytes: number;
+      readsAtCancel: number;
+    }[] = [];
+    vi.spyOn(strict, "readStrictGzip").mockImplementation((owned) => {
+      const inner = originalRead(owned);
+      const state = {
+        cancelled: false,
+        reads: 0,
+        bytes: 0,
+        readsAtCancel: 0,
+      };
+      observations.push(state);
+      const observed: strict.StrictGzipReader = {
+        [Symbol.asyncIterator]() {
+          return observed;
+        },
+        async next() {
+          assert.equal(state.cancelled, false);
+          state.reads++;
+          const result = await inner.next();
+          if (!result.done) state.bytes += result.value.byteLength;
+          return result;
+        },
+        return() {
+          state.cancelled = true;
+          state.readsAtCancel = state.reads;
+          return inner.return();
+        },
+        cancel() {
+          state.cancelled = true;
+          state.readsAtCancel = state.reads;
+          inner.cancel();
+        },
+      };
+      return observed;
+    });
+    const variants = resourceFirstVariants(
+      '{"ok":true}',
+      SYNC_BATCH_MAX_DECODED_BYTES,
+    );
+    for (const [kind, wire] of variants) {
+      const before = wire.slice();
+      await assert.rejects(
+        decompressSyncBatchMessage(wire),
+        (error: unknown) => {
+          assert.ok(error instanceof SyncBatchExpansionError, kind);
+          assert.equal(observations.at(-1)!.cancelled, true);
+          return true;
+        },
+      );
+      assert.deepEqual(wire, before);
+      const state = observations.at(-1)!;
+      assert.ok(state.bytes > SYNC_BATCH_MAX_DECODED_BYTES);
+      assert.ok(state.bytes <= SYNC_BATCH_MAX_DECODED_BYTES + 8192);
+      await new Promise<void>((resolve) => setImmediate(resolve));
+      assert.equal(state.reads, state.readsAtCancel);
+    }
+  }, 60_000);
+
+  test("ordinary stream cancellation cannot hold parsing hostage", async () => {
+    for (const cancellation of ["reject", "pending"] as const) {
+      let cancelled = false;
+      const stream = new ReadableStream<Uint8Array>({
+        start(controller) {
+          controller.enqueue(new Uint8Array(SYNC_BATCH_MAX_DECODED_BYTES + 1));
+        },
+        cancel() {
+          cancelled = true;
+          return cancellation === "reject"
+            ? Promise.reject(new Error("fixture cancellation"))
+            : new Promise<void>(() => {});
+        },
+      });
+      await assert.rejects(readSyncBatchJson(stream), SyncBatchExpansionError);
+      assert.equal(cancelled, true);
+      assert.equal(stream.locked, false);
+    }
+  });
+});
