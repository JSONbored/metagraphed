{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": ["generated/**", "public/**", "dist/**"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [],
  "includeEntryExports": false,
  "workspaces": {
    ".": {
      "entry": [
        "workers/api.entry.ts",
        "workers/data-api.ts",
        "workers/chain-firehose-hub.ts",
        "workers/mcp-session-hub.ts",
        "workers/alerter-hub.ts",
        "workers/registry-sync-api.ts",
        "workers/wss-lb.ts",
        "src/mcp-server.ts",
        "schemas-src/openapi-registry.ts",
        "scripts/*.ts",
        "scripts/lib/*.ts",
        "tests/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "workers/**/*.ts",
        "schemas-src/**/*.ts",
        "scripts/**/*.ts"
      ]
    },
    "apps/ui": {
      "entry": [
        "src/routes/**/*.{ts,tsx}",
        "src/router.tsx",
        "src/client.tsx",
        "src/server.ts",
        "src/**/*.test.{ts,tsx}",
        "tests/**/*.ts",
        "scripts/*.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.ts", "scripts/**/*.ts"],
      "ignore": [
        "src/routeTree.gen.ts",
        "src/components/metagraphed/design/design-tokens.generated.ts"
      ]
    },
    "packages/ui-kit": {
      "entry": ["src/index.ts", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["dist/**"]
    }
  }
}
