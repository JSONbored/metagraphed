{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metagraph.sh/schemas/components/07-endpoints-rpc.schema.json",
  "title": "Metagraphed OpenAPI components 07-endpoints-rpc",
  "type": "object",
  "components": {
    "schemas": {
      "EndpointIncident": {
        "type": "object",
        "required": [
          "id",
          "endpoint_id",
          "surface_id",
          "surface_key",
          "netuid",
          "layer",
          "kind",
          "provider",
          "operator",
          "status",
          "classification",
          "severity",
          "state",
          "reason",
          "detected_at",
          "observed_at",
          "health_source",
          "health_stale",
          "last_ok",
          "last_checked",
          "pool_eligible",
          "user_reported",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "endpoint_id": {
            "type": "string"
          },
          "surface_id": {
            "type": "string"
          },
          "surface_key": {
            "type": "string",
            "description": "Stable surface identity (#1005): hash of netuid|kind|url for the affected surface."
          },
          "netuid": {
            "type": "integer",
            "minimum": 0
          },
          "subnet_slug": {
            "type": "string"
          },
          "subnet_name": {
            "type": "string"
          },
          "layer": {
            "$ref": "#/components/schemas/EndpointLayer"
          },
          "kind": {
            "$ref": "#/components/schemas/SurfaceKind"
          },
          "provider": {
            "type": "string"
          },
          "operator": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "classification": {
            "$ref": "#/components/schemas/Classification"
          },
          "severity": {
            "enum": ["critical", "warning", "info"]
          },
          "state": {
            "enum": ["active", "resolved"]
          },
          "reason": {
            "type": "string"
          },
          "detected_at": {
            "type": "string"
          },
          "observed_at": {
            "type": ["string", "null"]
          },
          "health_source": {
            "enum": ["probe-derived", "missing-probe", "not-monitored"]
          },
          "health_stale": {
            "type": "boolean"
          },
          "last_ok": {
            "type": ["string", "null"]
          },
          "last_checked": {
            "type": ["string", "null"]
          },
          "pool_eligible": {
            "type": "boolean"
          },
          "user_reported": {
            "type": "boolean"
          },
          "source": {
            "const": "probe-derived"
          }
        },
        "additionalProperties": false
      },
      "EndpointIncidentSummary": {
        "type": "object",
        "required": ["incident_count", "active_count"],
        "properties": {
          "incident_count": {
            "type": "integer",
            "minimum": 0
          },
          "active_count": {
            "type": "integer",
            "minimum": 0
          },
          "by_kind": {
            "$ref": "#/components/schemas/CountMap"
          },
          "by_layer": {
            "$ref": "#/components/schemas/CountMap"
          },
          "by_provider": {
            "$ref": "#/components/schemas/CountMap"
          },
          "by_severity": {
            "$ref": "#/components/schemas/CountMap"
          },
          "by_status": {
            "$ref": "#/components/schemas/CountMap"
          }
        },
        "additionalProperties": false
      },
      "EndpointSummary": {
        "type": "object",
        "required": [
          "endpoint_count",
          "monitored_count",
          "pool_eligible_count"
        ],
        "properties": {
          "endpoint_count": {
            "type": "integer",
            "minimum": 0
          },
          "monitored_count": {
            "type": "integer",
            "minimum": 0
          },
          "pool_eligible_count": {
            "type": "integer",
            "minimum": 0
          },
          "by_kind": {
            "$ref": "#/components/schemas/CountMap"
          },
          "by_layer": {
            "$ref": "#/components/schemas/CountMap"
          },
          "by_provider": {
            "$ref": "#/components/schemas/CountMap"
          },
          "by_publication_state": {
            "$ref": "#/components/schemas/CountMap"
          },
          "by_status": {
            "$ref": "#/components/schemas/CountMap"
          }
        },
        "additionalProperties": false
      },
      "EndpointPoolsArtifact": {
        "$ref": "#/components/schemas/RpcPoolsArtifact"
      },
      "EndpointIncidentsArtifact": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ArtifactBase"
          },
          {
            "type": "object",
            "required": ["summary", "incidents"],
            "properties": {
              "summary": {
                "$ref": "#/components/schemas/EndpointIncidentSummary"
              },
              "incidents": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/EndpointIncident"
                }
              }
            },
            "additionalProperties": true
          }
        ]
      },
      "EndpointsArtifact": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ArtifactBase"
          },
          {
            "type": "object",
            "required": ["summary", "endpoints"],
            "properties": {
              "summary": {
                "$ref": "#/components/schemas/EndpointSummary"
              },
              "endpoints": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/EndpointResource"
                }
              }
            },
            "additionalProperties": true
          }
        ]
      },
      "SubnetEndpointsArtifact": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ArtifactBase"
          },
          {
            "type": "object",
            "required": ["netuid", "summary", "endpoints"],
            "properties": {
              "netuid": {
                "type": "integer",
                "minimum": 0
              },
              "slug": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "summary": {
                "$ref": "#/components/schemas/EndpointSummary"
              },
              "endpoints": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/EndpointResource"
                }
              }
            },
            "additionalProperties": true
          }
        ]
      }
    }
  }
}
