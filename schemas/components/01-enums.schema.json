{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metagraph.sh/schemas/components/01-enums.schema.json",
  "title": "Metagraphed OpenAPI components 01-enums",
  "type": "object",
  "components": {
    "schemas": {
      "CacheProfile": {
        "enum": ["short", "standard", "static"]
      },
      "ProviderKind": {
        "enum": [
          "subnet-team",
          "infrastructure-provider",
          "data-provider",
          "docs-provider",
          "registry"
        ]
      },
      "EndpointPublicationState": {
        "enum": [
          "candidate",
          "verified",
          "monitored",
          "pool-eligible",
          "disabled",
          "rejected"
        ]
      },
      "PartnershipTier": {
        "description": "Display/placement tier for a subnet \u2014 e.g. a featured-pilot homepage slot. Distinct from Authority and CurationLevel, which are trust signals only and never drive placement.",
        "enum": ["pilot"]
      },
      "CandidateState": {
        "enum": [
          "schema-invalid",
          "schema-valid",
          "maintainer-review",
          "verified",
          "stale",
          "rejected"
        ]
      },
      "SubnetStatus": {
        "enum": ["active", "inactive", "unknown"]
      },
      "SubnetType": {
        "enum": ["root", "application"]
      }
    }
  }
}
