{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metagraph.sh/schemas/components/00-core.schema.json",
  "title": "Metagraphed OpenAPI components 00-core",
  "type": "object",
  "components": {
    "schemas": {
      "ArtifactBase": {
        "type": "object",
        "required": ["schema_version", "generated_at"],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "contract_version": {
            "type": "string"
          },
          "generated_at": {
            "type": "string"
          },
          "notes": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "additionalProperties": true
      }
    }
  }
}
