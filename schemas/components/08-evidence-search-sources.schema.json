{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metagraph.sh/schemas/components/08-evidence-search-sources.schema.json",
  "title": "Metagraphed OpenAPI components 08-evidence-search-sources",
  "type": "object",
  "components": {
    "schemas": {
      "EvidenceClaim": {
        "type": "object",
        "required": [
          "claim",
          "subject",
          "source_url",
          "source_type",
          "source_tier",
          "confidence",
          "support_summary",
          "limits"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "source_tier": {
            "$ref": "#/components/schemas/SourceTier"
          },
          "confidence": {
            "enum": ["low", "medium", "high"]
          },
          "support_summary": {
            "type": "string"
          },
          "limits": {
            "type": "string"
          },
          "verified_at": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      },
      "EvidenceLedgerArtifact": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ArtifactBase"
          },
          {
            "type": "object",
            "required": ["claims"],
            "properties": {
              "claims": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/EvidenceClaim"
                }
              }
            },
            "additionalProperties": true
          }
        ]
      },
      "SubnetEvidenceArtifact": {
        "$ref": "#/components/schemas/EvidenceLedgerArtifact"
      }
    }
  }
}
