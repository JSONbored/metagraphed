{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metagraph.sh/schemas/components/06-health.schema.json",
  "title": "Metagraphed OpenAPI components 06-health",
  "type": "object",
  "components": {
    "schemas": {
      "HealthLatestArtifact": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ArtifactBase"
          },
          {
            "type": "object",
            "required": ["observed_at", "summary", "surfaces"],
            "properties": {
              "observed_at": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "summary": {
                "type": "object",
                "description": "Network-wide health rollup for this observation (#9800). Was a bare open object, so the headline health figures were undeclared. `status_counts` is keyed by health verdict, so a new verdict adds a key rather than changing the contract -- a typed record, not opacity.",
                "properties": {
                  "surface_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "status_counts": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "additionalProperties": true
              },
              "surfaces": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/HealthSurface"
                }
              }
            },
            "additionalProperties": true
          }
        ]
      },
      "HealthBadgeArtifact": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ArtifactBase"
          },
          {
            "type": "object",
            "required": [
              "netuid",
              "label",
              "message",
              "status",
              "color",
              "surface_count"
            ],
            "properties": {
              "netuid": {
                "type": "integer",
                "minimum": 0
              },
              "label": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "status": {
                "$ref": "#/components/schemas/HealthStatus"
              },
              "color": {
                "type": "string"
              },
              "surface_count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": true
          }
        ]
      }
    }
  }
}
