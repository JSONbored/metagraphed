{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metagraph.sh/schemas/components/06-health.schema.json",
  "title": "Metagraphed OpenAPI components 06-health",
  "type": "object",
  "components": {
    "schemas": {
      "HealthLatestArtifact": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ArtifactBase"
          },
          {
            "type": "object",
            "required": ["observed_at", "summary", "surfaces"],
            "properties": {
              "observed_at": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "summary": {
                "type": "object",
                "additionalProperties": true
              },
              "surfaces": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/HealthSurface"
                }
              }
            },
            "additionalProperties": true
          }
        ]
      },
      "HealthBadgeArtifact": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ArtifactBase"
          },
          {
            "type": "object",
            "required": [
              "netuid",
              "label",
              "message",
              "status",
              "color",
              "surface_count"
            ],
            "properties": {
              "netuid": {
                "type": "integer",
                "minimum": 0
              },
              "label": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "status": {
                "$ref": "#/components/schemas/HealthStatus"
              },
              "color": {
                "type": "string"
              },
              "surface_count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": true
          }
        ]
      },
      "ScoreDistribution": {
        "type": ["object", "null"],
        "description": "Distribution summary of a 0\u20131 per-UID score across neurons: count, mean, min, max, and the p10/p25/p50/p75/p90 nearest-rank percentiles. Null when no neuron carries a finite score (a cold store or an empty network).",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "mean": {
            "type": ["number", "null"]
          },
          "min": {
            "type": ["number", "null"]
          },
          "max": {
            "type": ["number", "null"]
          },
          "p10": {
            "type": ["number", "null"]
          },
          "p25": {
            "type": ["number", "null"]
          },
          "p50": {
            "type": ["number", "null"]
          },
          "p75": {
            "type": ["number", "null"]
          },
          "p90": {
            "type": ["number", "null"]
          }
        },
        "additionalProperties": true
      },
      "ConcentrationMetrics": {
        "type": ["object", "null"],
        "description": "One concentration lens over a single value distribution: holder count, total, and the Gini, HHI (raw and holder-count-normalized), Nakamoto coefficient, top-percentile cumulative shares, and Shannon entropy (raw and normalized) measures. Null when the distribution is empty (a cold store or an all-zero column).",
        "properties": {
          "holders": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": ["number", "null"]
          },
          "gini": {
            "type": ["number", "null"]
          },
          "hhi": {
            "type": ["number", "null"]
          },
          "hhi_normalized": {
            "type": ["number", "null"]
          },
          "nakamoto_coefficient": {
            "type": ["integer", "null"]
          },
          "top_1pct_share": {
            "type": ["number", "null"]
          },
          "top_5pct_share": {
            "type": ["number", "null"]
          },
          "top_10pct_share": {
            "type": ["number", "null"]
          },
          "top_20pct_share": {
            "type": ["number", "null"]
          },
          "entropy": {
            "type": ["number", "null"]
          },
          "entropy_normalized": {
            "type": ["number", "null"]
          }
        },
        "additionalProperties": true
      },
      "SubnetYieldHistoryArtifact": {
        "type": "object",
        "description": "Per-day emission-yield distribution trend for one subnet (newest first) over a 7d/30d/90d window: the subnet-wide return plus the mean/median/p25/p75/p90 of the per-UID emission-per-stake yields. The return-rate twin of /concentration/history and the time-series companion to the /yield snapshot \u2014 the per-UID yield distribution (median/percentiles) is not reconstructable from the stake+emission totals in /history. Computed live from the neuron_daily D1 rollup.",
        "required": ["schema_version", "netuid", "point_count", "points"],
        "properties": {
          "schema_version": {
            "type": "integer"
          },
          "netuid": {
            "type": "integer",
            "minimum": 0
          },
          "window": {
            "type": ["string", "null"]
          },
          "point_count": {
            "type": "integer",
            "minimum": 0
          },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["snapshot_date"],
              "properties": {
                "snapshot_date": {
                  "type": "string"
                },
                "neuron_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "validator_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "yield_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "subnet_yield": {
                  "type": ["number", "null"]
                },
                "mean_yield": {
                  "type": ["number", "null"]
                },
                "median_yield": {
                  "type": ["number", "null"]
                },
                "p25_yield": {
                  "type": ["number", "null"]
                },
                "p75_yield": {
                  "type": ["number", "null"]
                },
                "p90_yield": {
                  "type": ["number", "null"]
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  }
}
