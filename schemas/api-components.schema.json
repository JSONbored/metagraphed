{
  "$id": "https://metagraph.sh/schemas/api-components.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "components": {
    "schemas": {
      "ArtifactBase": {
        "additionalProperties": true,
        "properties": {
          "contract_version": {
            "type": "string"
          },
          "generated_at": {
            "type": "string"
          },
          "notes": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "schema_version": {
            "const": 1
          }
        },
        "required": [
          "schema_version",
          "generated_at"
        ],
        "type": "object"
      },
      "CacheProfile": {
        "enum": [
          "short",
          "standard",
          "static"
        ]
      },
      "CandidateState": {
        "enum": [
          "schema-invalid",
          "schema-valid",
          "maintainer-review",
          "verified",
          "stale",
          "rejected"
        ]
      },
      "EndpointPublicationState": {
        "enum": [
          "candidate",
          "verified",
          "monitored",
          "pool-eligible",
          "disabled",
          "rejected"
        ]
      },
      "ErrorEnvelope": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          },
          "ok": {
            "const": false
          },
          "schema_version": {
            "const": 1
          }
        },
        "required": [
          "ok",
          "schema_version",
          "data",
          "error",
          "meta"
        ],
        "type": "object"
      },
      "GenericArtifact": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ArtifactBase"
          }
        ]
      },
      "HealthBadgeArtifact": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ArtifactBase"
          },
          {
            "additionalProperties": true,
            "properties": {
              "color": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "netuid": {
                "minimum": 0,
                "type": "integer"
              },
              "status": {
                "$ref": "#/components/schemas/HealthStatus"
              },
              "surface_count": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "netuid",
              "label",
              "message",
              "status",
              "color",
              "surface_count"
            ],
            "type": "object"
          }
        ]
      },
      "HealthLatestArtifact": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ArtifactBase"
          },
          {
            "additionalProperties": true,
            "properties": {
              "observed_at": {
                "format": "date-time",
                "type": [
                  "string",
                  "null"
                ]
              },
              "summary": {
                "additionalProperties": true,
                "type": "object"
              },
              "surfaces": {
                "items": {
                  "$ref": "#/components/schemas/HealthSurface"
                },
                "type": "array"
              }
            },
            "required": [
              "observed_at",
              "summary",
              "surfaces"
            ],
            "type": "object"
          }
        ]
      },
      "OperationalSurfacesArtifact": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ArtifactBase"
          },
          {
            "additionalProperties": true,
            "properties": {
              "kinds": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "surface_count": {
                "minimum": 0,
                "type": "integer"
              },
              "surfaces": {
                "items": {
                  "additionalProperties": true,
                  "properties": {
                    "auth_required": {
                      "type": "boolean"
                    },
                    "authority": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string"
                    },
                    "netuid": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "probe": {
                      "additionalProperties": true,
                      "properties": {
                        "expect": {
                          "type": "string"
                        },
                        "method": {
                          "type": "string"
                        },
                        "timeout_ms": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "method",
                        "expect"
                      ],
                      "type": "object"
                    },
                    "provider": {
                      "type": "string"
                    },
                    "public_safe": {
                      "type": "boolean"
                    },
                    "subnet_name": {
                      "type": "string"
                    },
                    "subnet_slug": {
                      "type": "string"
                    },
                    "surface_id": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "surface_id",
                    "netuid",
                    "kind",
                    "url",
                    "probe"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "surface_count",
              "kinds",
              "surfaces"
            ],
            "type": "object"
          }
        ]
      },
      "PaginationMeta": {
        "additionalProperties": false,
        "properties": {
          "collection": {
            "type": "string"
          },
          "cursor": {
            "minimum": 0,
            "type": "integer"
          },
          "limit": {
            "minimum": 0,
            "type": "integer"
          },
          "next_cursor": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "order": {
            "enum": [
              "asc",
              "desc"
            ]
          },
          "returned": {
            "minimum": 0,
            "type": "integer"
          },
          "sort": {
            "type": [
              "string",
              "null"
            ]
          },
          "total": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "collection",
          "total",
          "returned",
          "limit",
          "cursor",
          "next_cursor"
        ],
        "type": "object"
      },
      "PartnershipTier": {
        "description": "Display/placement tier for a subnet — e.g. a featured-pilot homepage slot. Distinct from Authority and CurationLevel, which are trust signals only and never drive placement.",
        "enum": [
          "pilot"
        ]
      },
      "ProviderKind": {
        "enum": [
          "subnet-team",
          "infrastructure-provider",
          "data-provider",
          "docs-provider",
          "registry"
        ]
      },
      "R2ManifestArtifact": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ArtifactBase"
          },
          {
            "additionalProperties": true,
            "properties": {
              "artifact_count": {
                "minimum": 0,
                "type": "integer"
              },
              "artifact_size_bytes": {
                "minimum": 0,
                "type": "integer"
              },
              "artifacts": {
                "items": {
                  "$ref": "#/components/schemas/R2ManifestEntry"
                },
                "type": "array"
              },
              "bucket_binding": {
                "type": "string"
              },
              "bucket_name": {
                "type": "string"
              },
              "latest_prefix": {
                "type": "string"
              },
              "run_prefix": {
                "type": "string"
              }
            },
            "required": [
              "artifact_count",
              "artifact_size_bytes",
              "artifacts",
              "bucket_binding",
              "bucket_name",
              "latest_prefix",
              "run_prefix"
            ],
            "type": "object"
          }
        ]
      },
      "R2ManifestEntry": {
        "additionalProperties": false,
        "properties": {
          "content_type": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "latest_key": {
            "type": "string"
          },
          "path": {
            "pattern": "^/metagraph/",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "size_bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "storage_tier": {
            "enum": [
              "dual",
              "git",
              "r2"
            ]
          }
        },
        "required": [
          "content_type",
          "key",
          "latest_key",
          "path",
          "sha256",
          "size_bytes",
          "storage_tier"
        ],
        "type": "object"
      },
      "ResponseMeta": {
        "additionalProperties": true,
        "properties": {
          "artifact_path": {
            "type": "string"
          },
          "cache": {
            "$ref": "#/components/schemas/CacheProfile"
          },
          "contract_version": {
            "type": "string"
          },
          "generated_at": {
            "description": "Deterministic build content marker (epoch by default); not a wall clock. Use published_at for human-facing freshness.",
            "type": [
              "string",
              "null"
            ]
          },
          "pagination": {
            "$ref": "#/components/schemas/PaginationMeta"
          },
          "published_at": {
            "description": "Real publish time from the KV latest pointer, distinct from generated_at. Null before the first publish or when the control KV is unbound.",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "string"
          },
          "stale_contract": {
            "additionalProperties": false,
            "description": "Present ONLY when the served artifact was built under an older contract than the live one (serve-time drift, #1001) — the body may predate a schema change. Mirrored on the x-metagraph-stale-contract response header for monitoring.",
            "properties": {
              "built_under": {
                "description": "Contract version the served artifact was built under.",
                "type": "string"
              },
              "live": {
                "description": "Current (live) contract version the Worker is running.",
                "type": "string"
              }
            },
            "required": [
              "built_under",
              "live"
            ],
            "type": "object"
          }
        },
        "required": [
          "contract_version"
        ],
        "type": "object"
      },
      "ReviewCurationArtifact": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ArtifactBase"
          },
          {
            "additionalProperties": true,
            "properties": {
              "adapter_candidates": {
                "items": {
                  "$ref": "#/components/schemas/ReviewAdapterCandidate"
                },
                "type": "array"
              },
              "gap_priorities": {
                "items": {
                  "$ref": "#/components/schemas/ReviewGapPriority"
                },
                "type": "array"
              },
              "review_decisions": {
                "items": {
                  "$ref": "#/components/schemas/ReviewDecision"
                },
                "type": "array"
              },
              "summary": {
                "additionalProperties": false,
                "properties": {
                  "adapter_candidate_count": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "gap_kind_counts": {
                    "$ref": "#/components/schemas/CountMap"
                  },
                  "maintainer_decision_count": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "needs_maintainer_review_count": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "subnet_count": {
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "adapter_candidate_count",
                  "gap_kind_counts",
                  "maintainer_decision_count",
                  "needs_maintainer_review_count",
                  "subnet_count"
                ],
                "type": "object"
              }
            },
            "required": [
              "adapter_candidates",
              "gap_priorities",
              "review_decisions",
              "summary"
            ],
            "type": "object"
          }
        ]
      },
      "ReviewDecision": {
        "additionalProperties": false,
        "properties": {
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "decision": {
            "enum": [
              "maintainer-reviewed",
              "needs-review",
              "rejected",
              "stale"
            ]
          },
          "netuid": {
            "minimum": 0,
            "type": "integer"
          },
          "notes": {
            "type": "string"
          },
          "reviewed_at": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "source_urls": {
            "items": {
              "format": "uri",
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "confidence",
          "decision",
          "netuid",
          "notes",
          "reviewed_at",
          "slug",
          "source_urls"
        ],
        "type": "object"
      },
      "ReviewDecisionsArtifact": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ArtifactBase"
          },
          {
            "additionalProperties": true,
            "properties": {
              "decisions": {
                "items": {
                  "$ref": "#/components/schemas/ReviewDecision"
                },
                "type": "array"
              }
            },
            "required": [
              "decisions"
            ],
            "type": "object"
          }
        ]
      },
      "ReviewQueueArtifact": {
        "$ref": "#/components/schemas/CandidatesArtifact"
      },
      "SchemaDriftArtifact": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ArtifactBase"
          },
          {
            "additionalProperties": true,
            "properties": {
              "openapi_surface_count": {
                "minimum": 0,
                "type": "integer"
              },
              "schema_backed_surface_count": {
                "minimum": 0,
                "type": "integer"
              },
              "source": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "captured",
                  "error",
                  "not-found",
                  "not-snapshotted",
                  "unsafe"
                ]
              },
              "surfaces": {
                "items": {
                  "$ref": "#/components/schemas/SchemaDriftSurface"
                },
                "type": "array"
              }
            },
            "required": [
              "openapi_surface_count",
              "schema_backed_surface_count",
              "source",
              "status",
              "surfaces"
            ],
            "type": "object"
          }
        ]
      },
      "SchemaDriftSurface": {
        "additionalProperties": false,
        "properties": {
          "drift_status": {
            "enum": [
              "changed",
              "missing-after-previous-capture",
              "new",
              "not-captured",
              "unchanged"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "netuid": {
            "minimum": 0,
            "type": "integer"
          },
          "previous_hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "schema_url": {
            "format": "uri",
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "captured",
              "error",
              "not-found",
              "pending-snapshot",
              "too-large",
              "ui-only-or-undiscovered",
              "unsafe"
            ]
          },
          "subnet_slug": {
            "type": "string"
          },
          "surface_id": {
            "type": "string"
          },
          "url": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "netuid",
          "schema_url",
          "status",
          "subnet_slug",
          "surface_id",
          "url"
        ],
        "type": "object"
      },
      "SubnetStatus": {
        "enum": [
          "active",
          "inactive",
          "unknown"
        ]
      },
      "SubnetType": {
        "enum": [
          "root",
          "application"
        ]
      },
      "SubnetVerificationArtifact": {
        "$ref": "#/components/schemas/VerificationArtifact"
      },
      "SuccessEnvelope": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "additionalProperties": true,
            "type": "object"
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          },
          "ok": {
            "const": true
          },
          "schema_version": {
            "const": 1
          }
        },
        "required": [
          "ok",
          "schema_version",
          "data",
          "meta"
        ],
        "type": "object"
      },
      "SurfaceAliasesArtifact": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ArtifactBase"
          },
          {
            "additionalProperties": true,
            "properties": {
              "aliases": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "current_id": {
                      "type": "string"
                    },
                    "deprecated_id": {
                      "type": "string"
                    },
                    "kind": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "netuid": {
                      "minimum": 0,
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "surface_key": {
                      "type": "string"
                    },
                    "url": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "deprecated_id",
                    "surface_key",
                    "current_id"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "source": {
                "const": "generated-surface-rename-aliases"
              },
              "summary": {
                "additionalProperties": false,
                "properties": {
                  "alias_count": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "carried_alias_count": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "current_surface_count": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "new_alias_count": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "previous_surface_count": {
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "alias_count",
                  "carried_alias_count",
                  "new_alias_count",
                  "previous_surface_count",
                  "current_surface_count"
                ],
                "type": "object"
              }
            },
            "required": [
              "source",
              "summary",
              "aliases"
            ],
            "type": "object"
          }
        ]
      },
      "VerificationArtifact": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ArtifactBase"
          },
          {
            "additionalProperties": true,
            "properties": {
              "candidate_count": {
                "minimum": 0,
                "type": "integer"
              },
              "observed_at": {
                "format": "date-time",
                "type": [
                  "string",
                  "null"
                ]
              },
              "results": {
                "items": {
                  "$ref": "#/components/schemas/VerificationResult"
                },
                "type": "array"
              },
              "summary": {
                "additionalProperties": true,
                "type": "object"
              }
            },
            "required": [
              "candidate_count",
              "results"
            ],
            "type": "object"
          }
        ]
      }
    }
  },
  "description": "Generated bundle of canonical reusable JSON Schema components embedded into the generated OpenAPI contract. Edit schemas/components/*.schema.json instead.",
  "properties": {
    "components": {
      "additionalProperties": false,
      "properties": {
        "schemas": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "schemas"
      ],
      "type": "object"
    }
  },
  "required": [
    "components"
  ],
  "title": "Metagraphed API Component Schemas",
  "type": "object"
}
